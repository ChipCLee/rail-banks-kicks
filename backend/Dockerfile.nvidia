FROM ghcr.io/astral-sh/uv:0.8.23 AS uv
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

COPY --from=uv /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .python-version ./
# Keep the CUDA-enabled Torch supplied by the base image; install every other
# locked dependency with uv into that image's managed Python environment.
RUN uv export --frozen --no-dev --no-emit-project \
      --no-emit-package torch --no-emit-package torchvision \
      --output-file /tmp/requirements.lock \
    && uv pip install --system --no-cache -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock

COPY . .

ENV CV_DEVICE=cuda
ENV YOLO_MODEL_PATH=/app/weights/rail_kick_yolov8s_seg.pt

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
